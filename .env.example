# ─────────────────────────────────────────────────────────────────────────────
# Global Sangha Map — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Google Calendar API key (required for live data).
# Create one at https://console.cloud.google.com/apis/credentials
# and enable the "Google Calendar API". Restrict it to the Calendar API.
# If this is left blank, the app falls back to bundled sample events so the
# UI still renders for local development / preview.
GOOGLE_CALENDAR_API_KEY=

# The public Tergar community calendar ID (defaults to the value in specs.md).
# Override only if pointing at a different calendar.
GOOGLE_CALENDAR_ID=tergar.org_m5aemau76dov0it82j05fun6hg@group.calendar.google.com

# Contact email used as the User-Agent identifier for the OpenStreetMap
# Nominatim geocoding API (required by their usage policy). Optional but
# recommended for production deployments.
NOMINATIM_CONTACT_EMAIL=
